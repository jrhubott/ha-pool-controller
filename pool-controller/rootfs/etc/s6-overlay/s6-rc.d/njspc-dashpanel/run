#!/command/with-contenv bashio
bashio::log.info "Starting nodejs-poolController dashPanel..."
cd /app/dashpanel || bashio::exit.nok "Could not change to /app/dashpanel"

# Tell dashPanel where to find the controller (same container, loopback)
export POOL_WEB_SERVICES_IP=localhost
export POOL_WEB_SERVICES_PORT=4200
export POOL_WEB_SERVICES_PROTOCOL=http

exec node dist/app.js
